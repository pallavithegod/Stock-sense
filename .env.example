# StockSense - Environment Example
# Copy this file to .env and fill in private values locally.

# Primary APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
TWELVE_DATA_API_KEY=your_twelve_data_api_key
NEWS_API_KEY=your_news_api_key
FINNHUB_API_KEY=your_finnhub_api_key
FMP_API_KEY=your_fmp_api_key
DATA_GOV_API_KEY=your_data_gov_api_key
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token

# Optional / legacy API aliases
YAHOO_FINANCE_KEY=
ALPHA_VANTAGE_KEY=
TWELVE_DATA_KEY=
FINNHUB_KEY=

# Flask / Socket.IO
APP_ENV=development
FLASK_SECRET_KEY=replace_with_a_long_random_secret
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEBUG=False
DEBUG_ENDPOINTS=False
OPEN_BROWSER=True
ENABLE_LEGACY_UI=False
TRUST_PROXY_HEADERS=False
TRUSTED_PROXY_COUNT=1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5173,http://localhost:5173
SOCKETIO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5173,http://localhost:5173
SOCKETIO_ASYNC_MODE=threading

# Supabase server-side values. Never expose the service-role key to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_AUTH=False

# SQLite
STOCKSENSE_DB_PATH=data/stocksense.db
STOCKSENSE_MARKET_DB_PATH=data/market_intelligence.db
STOCKSENSE_ADAPTIVE_DB_PATH=data/adaptive_thresholds.db
STOCKSENSE_AUDIT_LOG_PATH=data/prediction_audit.jsonl
DISABLE_STARTUP_NETWORK=False

# Public demo protection
# Keep false for local development. Set true in public demos and provide DEMO_WRITE_TOKEN.
REQUIRE_MUTATION_TOKEN=False
DEMO_WRITE_TOKEN=

# API protection
RATE_LIMIT_ENABLED=True
RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_PER_MINUTE=240
MUTATION_RATE_LIMIT_PER_MINUTE=40
MAX_JSON_BODY_BYTES=65536

# System Configuration
SYSTEM_MODE=REVOLUTIONARY
AI_MODELS_ENABLED=True
REAL_TIME_UPDATES=True

# Performance Settings
CACHE_TIMEOUT=60
STOCKSENSE_SYMBOL_CACHE_TTL=86400
STOCKSENSE_SYMBOL_UNIVERSE_LIMIT=50000
UPDATE_INTERVAL=30
MAX_STOCKS=3000
AI_CONFIDENCE_THRESHOLD=0.75

# Optional runtime JSON configuration
STOCKSENSE_INDICES_CONFIG=
